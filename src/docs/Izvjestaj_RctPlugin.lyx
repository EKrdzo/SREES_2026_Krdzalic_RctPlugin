\begin_layout Section
Matematički model toka snage u pravougaonim koordinatama
\end_layout

\begin_layout Subsection
Reprezentacija napona i osnovna jednačina snage
\end_layout

\begin_layout Standard
Za svaku sabirnicu 
\begin_inset Formula $i$
\end_inset

 napon se u pravougaonim (Kartezijevim) koordinatama zapisuje kao
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
V_{i}=e_{i}+jf_{i},\qquad e_{i}=\mathrm{Re}(V_{i}),\quad f_{i}=\mathrm{Im}(V_{i})
\]

\end_inset


\end_layout

\begin_layout Standard
Injektovana kompleksna snaga na sabirnici 
\begin_inset Formula $i$
\end_inset

 data je poznatim izrazom
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
S_{i}=P_{i}+jQ_{i}=V_{i}I_{i}^{*},\qquad I_{i}=\sum_{j}Y_{ij}V_{j}
\]

\end_inset


\end_layout

\begin_layout Standard
gdje je 
\begin_inset Formula $Y_{ij}=G_{ij}+jB_{ij}$
\end_inset

 element admitansne matrice mreže (Ybus),
 čija je gradnja objašnjena u narednoj podsekciji.
 Cilj je izraziti 
\begin_inset Formula $P_{i}$
\end_inset

 i 
\begin_inset Formula $Q_{i}$
\end_inset

 direktno preko 
\begin_inset Formula $e$
\end_inset

 i 
\begin_inset Formula $f$
\end_inset

 komponenti,
 čime se dobijaju jednačine koje su pogodne za Newton-Raphson rješavač.
\end_layout

\begin_layout Subsection
Formiranje matrice admitansi mreže (Ybus)
\end_layout

\begin_layout Standard
Ybus matrica se formira jednom,
 u pred-obradi (funkcija 
\family typewriter
buildY
\family default
),
 iz podataka o vodovima i transformatorima (blok 
\family typewriter
mpc.branch
\family default
),
 koristeći opći 
\begin_inset Formula $\pi$
\end_inset

-model grane sa transformatorskim odnosom.
 Za granu koja povezuje sabirnice 
\begin_inset Formula $fi$
\end_inset

 (from) i 
\begin_inset Formula $ti$
\end_inset

 (to),
 sa serijskom impedansom 
\begin_inset Formula $r+jx$
\end_inset

,
 šant susceptansom 
\begin_inset Formula $b$
\end_inset

,
 odnosom transformacije 
\begin_inset Formula $tap$
\end_inset

 i faznim pomakom 
\begin_inset Formula $shift$
\end_inset

,
 definišu se pomoćne veličine
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
a=tap\cdot e^{j\cdot shift},\qquad y_{s}=\frac{1}{r+jx},\qquad y_{b}=\frac{jb}{2}
\]

\end_inset


\end_layout

\begin_layout Standard
koje se zatim raspodjeljuju u odgovarajuće elemente Ybus matrice na sljedeći način:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
Y_{fi,fi}\mathrel{+}=\frac{y_{s}+y_{b}}{\left|a\right|^{2}},\qquad Y_{ti,ti}\mathrel{+}=y_{s}+y_{b}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
Y_{fi,ti}\mathrel{+}=-\frac{y_{s}}{a^{*}},\qquad Y_{ti,fi}\mathrel{+}=-\frac{y_{s}}{a}
\]

\end_inset


\end_layout

\begin_layout Standard
Dodatno,
 svaka sabirnica može imati vlastitu šant admitansu (blok 
\family typewriter
mpc.bus
\family default
,
 kolone 
\family typewriter
Gs
\family default
,
 
\family typewriter
Bs
\family default
),
 koja se,
 svedena na baznu snagu (
\family typewriter
baseMVA
\family default
),
 dodaje na dijagonalu:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
Y_{i,i}\mathrel{+}=\frac{G_{s,i}}{baseMVA}+j\frac{B_{s,i}}{baseMVA}
\]

\end_inset


\end_layout

\begin_layout Standard
Ovim postupkom,
 ponavljanim za sve grane i sve sabirnice,
 dobija se kompletna,
 rijetka (sparse) admitansna matrica 
\begin_inset Formula $Y_{ij}=G_{ij}+jB_{ij}$
\end_inset

,
 koja se u kodu čuva u strukturi 
\family typewriter
sparse::ICmplxMatrix
\family default
 i dalje se ne mijenja tokom iterativnog rješavanja.
\end_layout

\begin_layout Subsection
Izvođenje jednačina snage u pravougaonim koordinatama
\end_layout

\begin_layout Standard
Polazeći od 
\begin_inset Formula $I_{i}=\sum_{j}Y_{ij}V_{j}$
\end_inset

 i uvrštavanjem 
\begin_inset Formula $Y_{ij}=G_{ij}+jB_{ij}$
\end_inset

,
 
\begin_inset Formula $V_{j}=e_{j}+jf_{j}$
\end_inset

,
 konjugovana struja glasi
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
I_{i}^{*}=\sum_{j}\left[(G_{ij}e_{j}-B_{ij}f_{j})-j(G_{ij}f_{j}+B_{ij}e_{j})\right]
\]

\end_inset


\end_layout

\begin_layout Standard
Uvrštavanjem u 
\begin_inset Formula $S_{i}=(e_{i}+jf_{i})\cdot I_{i}^{*}$
\end_inset

 i razdvajanjem realnog i imaginarnog dijela,
 dobijaju se opće jednačine injektovane aktivne i reaktivne snage,
 izražene isključivo preko 
\begin_inset Formula $e$
\end_inset

 i 
\begin_inset Formula $f$
\end_inset

 komponenti napona:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
P_{i}=\sum_{j}\left[G_{ij}(e_{i}e_{j}+f_{i}f_{j})-B_{ij}(e_{i}f_{j}-f_{i}e_{j})\right]
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
Q_{i}=\sum_{j}\left[G_{ij}(f_{i}e_{j}-e_{i}f_{j})-B_{ij}(e_{i}e_{j}+f_{i}f_{j})\right]
\]

\end_inset


\end_layout

\begin_layout Standard
Ove jednačine su isključivo polinomske (kvadratne) po 
\begin_inset Formula $e$
\end_inset

 i 
\begin_inset Formula $f$
\end_inset

,
 bez sinusa i kosinusa koji bi se javili u polarnoj formulaciji —
 to je i osnovni razlog zašto je plugin implementiran u pravougaonim,
 a ne u polarnim koordinatama.
\end_layout

\begin_layout Subsection
Nelinearne jednačine (NLEs) po tipu sabirnice
\end_layout

\begin_layout Standard
Funkcija 
\family typewriter
writeDmodl
\family default
 iz gore izvedenih opštih izraza generiše konkretne jednačine za svaku sabirnicu,
 u zavisnosti od njenog tipa (kolona 
\family typewriter
type
\family default
 u 
\family typewriter
mpc.bus
\family default
).
 Prije toga,
 iz podataka o generatorima i potrošnji (
\family typewriter
mpc.gen
\family default
,
 
\family typewriter
mpc.bus
\family default
),
 svedenih na baznu snagu,
 računaju se poznate injekcije:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
P_{i}^{sp}=\frac{\sum P_{g}-P_{d,i}}{baseMVA},\qquad Q_{i}^{sp}=\frac{\sum Q_{g}-Q_{d,i}}{baseMVA}
\]

\end_inset


\end_layout

\begin_layout Itemize

\series bold
PQ sabirnica
\series default
 (tip 1,
 potrošačka) —
 nepoznate su 
\begin_inset Formula $e_{i}$
\end_inset

 i 
\begin_inset Formula $f_{i}$
\end_inset

,
 pa se postavljaju dvije jednačine (aktivna i reaktivna snaga moraju biti jednake zadanim vrijednostima):
\begin_inset Formula 
\[
P_{i}=P_{i}^{sp},\qquad Q_{i}=Q_{i}^{sp}
\]

\end_inset


\end_layout

\begin_layout Itemize

\series bold
PV sabirnica
\series default
 (tip 2,
 generatorska sa regulacijom napona) —
 poznata je proizvedena aktivna snaga i zadana magnituda napona 
\begin_inset Formula $V_{i}^{sp}$
\end_inset

,
 pa se postavlja jednačina aktivne snage i uslov fiksirane magnitude napona (reaktivna snaga 
\begin_inset Formula $Q_{i}$
\end_inset

 se ne fiksira,
 već se dobija u post-obradi):
\begin_inset Formula 
\[
P_{i}=P_{i}^{sp},\qquad e_{i}^{2}+f_{i}^{2}=\left(V_{i}^{sp}\right)^{2}
\]

\end_inset


\end_layout

\begin_layout Itemize

\series bold
Slack (balansna) sabirnica
\series default
 (tip 3) —
 magnituda i ugao napona su fiksirani i unaprijed poznati,
 pa 
\begin_inset Formula $e_{slack}$
\end_inset

 i 
\begin_inset Formula $f_{slack}$
\end_inset

 nisu nepoznate,
 već se u .dmodl fajlu zapisuju kao 
\family typewriter
Params
\family default
 i ne ulaze u sistem NLE jednačina.
 Ova sabirnica pokriva razliku (gubitke) u ukupnom bilansu snage mreže.
\end_layout

\begin_layout Standard
Sistem koji rješava dTwin sadrži,
 dakle,
 po dvije jednačine za svaku PQ sabirnicu i po dvije za svaku PV sabirnicu (ukupno 
\begin_inset Formula $2(n-1)$
\end_inset

 jednačina za mrežu sa 
\begin_inset Formula $n$
\end_inset

 sabirnica,
 od kojih je jedna slack),
 što je tačno onoliko koliko je nepoznatih 
\begin_inset Formula $e_{i},f_{i}$
\end_inset

 komponenti.
 Nakon konvergencije,
 u post-obradi se iz dobijenih napona računaju izvedene veličine:
 reaktivna snaga generatora na PV sabirnicama,
 snaga slack sabirnice (koja pokriva gubitke) i polarni oblik napona (magnituda i ugao) radi lakše interpretacije rezultata.
\end_layout

