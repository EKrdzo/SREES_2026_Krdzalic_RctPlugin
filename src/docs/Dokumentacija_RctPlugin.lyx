\begin_layout Section
Matematički model (ukratko)
\end_layout

\begin_layout Standard
Napon svake sabirnice zapisan je u pravougaonim koordinatama 
\begin_inset Formula $V_{i}=e_{i}+jf_{i}$
\end_inset

.
 Pravougaone koordinate su izabrane jer daju isključivo polinomske (kvadratne) jednačine,
 bez trigonometrijskih funkcija.
\end_layout

\begin_layout Subsection
Gradnja Ybus matrice (
\family typewriter
buildY
\family default
)
\end_layout

\begin_layout Standard
Za granu 
\begin_inset Formula $fi\to ti$
\end_inset

 sa impedansom 
\begin_inset Formula $r+jx$
\end_inset

,
 šant susceptansom 
\begin_inset Formula $b$
\end_inset

,
 odnosom transformacije 
\begin_inset Formula $tap$
\end_inset

 i faznim pomakom 
\begin_inset Formula $shift$
\end_inset

:
\end_layout

\begin_layout Standard
\begin_inset Formula \[
a=tap\cdot e^{j\cdot shift},\quad y_{s}=\frac{1}{r+jx},\quad y_{b}=\frac{jb}{2}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
Y_{fi,fi}\mathrel{+}=\frac{y_{s}+y_{b}}{\left|a\right|^{2}},\quad Y_{ti,ti}\mathrel{+}=y_{s}+y_{b},\quad Y_{fi,ti}\mathrel{+}=-\frac{y_{s}}{a^{*}},\quad Y_{ti,fi}\mathrel{+}=-\frac{y_{s}}{a}
\]

\end_inset


\end_layout

\begin_layout Standard
Šant admitansa sa bus podataka (
\family typewriter
Gs
\family default
,
 
\family typewriter
Bs
\family default
) se dodaje na dijagonalu,
 svedena na 
\family typewriter
baseMVA
\family default
.
\end_layout

\begin_layout Subsection
Jednačine snage po tipu sabirnice (
\family typewriter
writeDmodl
\family default
)
\end_layout

\begin_layout Standard
Iz 
\begin_inset Formula $S_{i}=V_{i}I_{i}^{*}$
\end_inset

 slijedi:
\end_layout

\begin_layout Standard
\begin_inset Formula \[
P_{i}=\sum_{j}\left[G_{ij}(e_{i}e_{j}+f_{i}f_{j})-B_{ij}(e_{i}f_{j}-f_{i}e_{j})\right]
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
Q_{i}=\sum_{j}\left[G_{ij}(f_{i}e_{j}-e_{i}f_{j})-B_{ij}(e_{i}e_{j}+f_{i}f_{j})\right]
\]

\end_inset


\end_layout

\begin_layout Itemize
\series bold
PQ
\series default
 (tip 1):
 
\begin_inset Formula $P_{i}=P_{i}^{sp}$
\end_inset

,
 
\begin_inset Formula $Q_{i}=Q_{i}^{sp}$
\end_inset


\end_layout

\begin_layout Itemize
\series bold
PV
\series default
 (tip 2):
 
\begin_inset Formula $P_{i}=P_{i}^{sp}$
\end_inset

,
 
\begin_inset Formula $e_{i}^{2}+f_{i}^{2}=(V_{i}^{sp})^{2}$
\end_inset


\end_layout

\begin_layout Itemize
\series bold
Slack
\series default
 (tip 3):
 
\begin_inset Formula $e_{slack}$
\end_inset

,
 
\begin_inset Formula $f_{slack}$
\end_inset

 su fiksni 
\family typewriter
Params
\family default
,
 ne ulaze u NLEs.
\end_layout

\begin_layout Section
Format .dmodl fajla
\end_layout

\begin_layout Standard
Generisani fajl je organizovan u sljedeće blokove:
\end_layout

\begin_layout Verbatim

Header:
\end_layout

\begin_layout Verbatim

    maxIter = 100
\end_layout

\begin_layout Verbatim

    report  = Solved
\end_layout

\begin_layout Verbatim

    maxReps = -1
\end_layout

\begin_layout Verbatim

    outToTxt = false
\end_layout

\begin_layout Verbatim

end
\end_layout

\begin_layout Verbatim

Model [type=NL domain=real eps=1e-6 name="..."]:
\end_layout

\begin_layout Verbatim

Vars [out=true]:
\end_layout

\begin_layout Verbatim

    e_2 = 1.0;
 f_2 = 0.0
\end_layout

\begin_layout Verbatim

    ...
\end_layout

\begin_layout Verbatim

Params:
\end_layout

\begin_layout Verbatim

    e_1 = 1.06 [out=true];
 f_1 = 0.0 [out=true]
\end_layout

\begin_layout Verbatim

    G_i_j = ...;
 B_i_j = ...
\end_layout

\begin_layout Verbatim

    P_i = ...;
 Q_i = ...
\end_layout

\begin_layout Verbatim

    Vsp2_i = ...
\end_layout

\begin_layout Verbatim

NLEs:
\end_layout

\begin_layout Verbatim

    G_2_2*(e_2^2+f_2^2) + ...
 = P_2
\end_layout

\begin_layout Verbatim

    ...
\end_layout

\begin_layout Verbatim

end
\end_layout

\begin_layout Standard
\series bold
Vars
\series default
 su nepoznate 
\begin_inset Formula $e_{i},f_{i}$
\end_inset

 za sve sabirnice osim slack,
 sa početnom pretpostavkom potrebnom iterativnom rješavaču.
 
\series bold
Params
\series default
 su fiksni slack napon,
 svi elementi Ybus matrice i sve poznate injekcije snaga.
 
\series bold
NLEs
\series default
 su konkretne jednačine iz prethodne sekcije,
 po jedna ili dvije za svaku sabirnicu ovisno o tipu.
\end_layout

